---
import gamesData from "../data/games";
import { formatPath } from "@/lib/utils";

interface Props {
    gameName: string;
}

const { gameName } = Astro.props;
const { pathname } = Astro.url;

const gameData = gamesData[gameName];

if (!gameData) {
    throw new Error(`Game data not found for ${gameName}`);
}

const levels = [];
for (let i = 0; i <= gameData.lastlevel; i++) {
    const urlName = `Level ${i}`;

    const slug = `${gameName}${i}`;
    const url = formatPath(`/wargames/${gameName}/${slug}`);

    levels.push({
        name: urlName,
        url: url,
        active: pathname === url || pathname === url + "/",
    });
}

const isLandingActive =
    pathname === formatPath(`/wargames/${gameName}`) ||
    pathname === formatPath(`/wargames/${gameName}/`);

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const displayName = capitalize(gameName);
---

<aside class="w-full shrink-0 md:w-56 lg:w-64">
    {/* SSH Info Section */}
    {
        gameData.host && gameData.port && (
            <div class="mb-4">
                <button
                    id="ssh-toggle"
                    class="flex w-full items-center justify-between rounded-lg border border-emerald-500/30 bg-emerald-950/30 px-4 py-3 text-sm font-semibold text-emerald-400 transition-colors hover:bg-emerald-900/30 md:hidden"
                >
                    <div class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="m10 15 5-3-5-3z" />
                        </svg>
                        SSH Info
                    </div>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 transition-transform duration-200"
                        id="ssh-arrow"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                <div
                    id="ssh-content"
                    class="hidden md:block mt-2 md:mt-0 rounded-lg border border-emerald-500/30 bg-emerald-950/30 p-4"
                >
                    <div class="mb-2 hidden items-center gap-2 text-sm font-semibold text-emerald-400 md:flex">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="m10 15 5-3-5-3z" />
                        </svg>
                        SSH Connection
                    </div>
                    <div class="space-y-2 font-mono text-xs">
                        <button
                            class="ssh-copy group w-full cursor-pointer rounded px-2 py-1.5 text-left transition-colors hover:bg-white/5"
                            data-copy={gameData.host}
                            title="Click to copy"
                        >
                            <div class="text-neutral-500 text-[10px] mb-0.5">
                                Host
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-neutral-300 truncate flex-1 min-w-0">
                                    {gameData.host}
                                </span>
                                <svg
                                    class="ml-2 h-3 w-3 shrink-0 text-neutral-600 opacity-0 transition-opacity group-hover:opacity-100"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <>
                                        <rect
                                            width="14"
                                            height="14"
                                            x="8"
                                            y="8"
                                            rx="2"
                                        />
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                    </>
                                </svg>
                            </div>
                        </button>
                        <button
                            class="ssh-copy group w-full cursor-pointer rounded px-2 py-1.5 text-left transition-colors hover:bg-white/5"
                            data-copy={String(gameData.port)}
                            title="Click to copy"
                        >
                            <div class="text-neutral-500 text-[10px] mb-0.5">
                                Port
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-neutral-300">
                                    {gameData.port}
                                </span>
                                <svg
                                    class="ml-2 h-3 w-3 shrink-0 text-neutral-600 opacity-0 transition-opacity group-hover:opacity-100"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <>
                                        <rect
                                            width="14"
                                            height="14"
                                            x="8"
                                            y="8"
                                            rx="2"
                                        />
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                    </>
                                </svg>
                            </div>
                        </button>
                        <button
                            class="ssh-copy group w-full cursor-pointer rounded px-2 py-1.5 text-left transition-colors hover:bg-white/5"
                            data-copy={`ssh ${gameName}0@${gameData.host} -p ${gameData.port}`}
                            title="Click to copy full SSH command"
                        >
                            <div class="text-neutral-500 text-[10px] mb-0.5">
                                SSH Command
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-neutral-300 truncate flex-1 min-w-0">
                                    ssh {gameName}0@{gameData.host} -p{" "}
                                    {gameData.port}
                                </span>
                                <svg
                                    class="ml-2 h-3 w-3 shrink-0 text-neutral-600 opacity-0 transition-opacity group-hover:opacity-100"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <>
                                        <rect
                                            width="14"
                                            height="14"
                                            x="8"
                                            y="8"
                                            rx="2"
                                        />
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                    </>
                                </svg>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        )
    }

    {/* Level Navigation Section */}
    <div>
        <button
            id="levels-toggle"
            class="flex w-full items-center justify-between rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 text-sm font-medium text-neutral-200 transition-colors hover:bg-neutral-900 md:hidden"
        >
            <span>Levels</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition-transform duration-200"
                id="levels-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>

        <nav
            id="levels-content"
            class="hidden md:block mt-2 md:mt-0 rounded-lg border border-white/10 bg-white/5 p-3"
        >
            <a
                href={formatPath(`/wargames/${gameName}`)}
                class={`mb-2 block rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors ${
                    isLandingActive
                        ? "bg-white/10 text-white"
                        : "text-neutral-400 hover:bg-white/5 hover:text-white"
                }`}
            >
                {displayName}
            </a>

            <div
                class="max-h-[280px] space-y-0.5 overflow-y-auto scrollbar-thin"
            >
                {
                    levels.map((level) => (
                        <a
                            href={level.url}
                            class={`block rounded-md px-3 py-1.5 text-xs no-underline transition-colors ${
                                level.active
                                    ? "bg-white/10 text-white"
                                    : "text-neutral-500 hover:bg-white/5 hover:text-neutral-300"
                            }`}
                        >
                            {level.name}
                        </a>
                    ))
                }
            </div>
        </nav>
    </div>
</aside>

<style>
    .scrollbar-thin::-webkit-scrollbar {
        width: 4px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 9999px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.2);
    }
    .scrollbar-thin {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
    }
</style>

<script>
    document.querySelectorAll(".ssh-copy").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const text = (btn as HTMLElement).dataset.copy;
            if (!text) return;
            try {
                await navigator.clipboard.writeText(text);
                const original = btn.getAttribute("title");
                btn.setAttribute("title", "Copied!");
                btn.classList.add("ring-1", "ring-emerald-500/30");
                setTimeout(() => {
                    btn.setAttribute("title", original || "Click to copy");
                    btn.classList.remove("ring-1", "ring-emerald-500/30");
                }, 1500);
            } catch (err) {
                console.error("Failed to copy:", err);
            }
        });
    });

    // Setup toggle for SSH info
    const sshToggle = document.getElementById("ssh-toggle");
    const sshContent = document.getElementById("ssh-content");
    const sshArrow = document.getElementById("ssh-arrow");

    if (sshToggle && sshContent && sshArrow) {
        sshToggle.addEventListener("click", () => {
            sshContent.classList.toggle("hidden");
            sshArrow.classList.toggle("rotate-180");
        });
    }

    // Setup toggle for Level list
    const levelsToggle = document.getElementById("levels-toggle");
    const levelsContent = document.getElementById("levels-content");
    const levelsArrow = document.getElementById("levels-arrow");

    if (levelsToggle && levelsContent && levelsArrow) {
        levelsToggle.addEventListener("click", () => {
            levelsContent.classList.toggle("hidden");
            levelsArrow.classList.toggle("rotate-180");
        });
    }
</script>
