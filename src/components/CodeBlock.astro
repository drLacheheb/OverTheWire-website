---
import { Code } from "astro:components";
import { Copy, Check } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props {
    code: string;
    class?: string;
    className?: string; // Support both for easier migration
}

const { code, class: className, className: classNameProp } = Astro.props;

// Determine language from className (e.g., "language-c" -> "c")
const finalClass = cn(className, classNameProp);
const languageMatch = finalClass?.match(/language-(\w+)/);
const lang = languageMatch ? languageMatch[1] : "text";

// Generate a unique ID for this block to handle copy functionality
const id = `code-block-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={cn("relative group mb-4", finalClass)}>
    <div class="rounded-lg overflow-hidden border border-border">
        <div
            class="relative overflow-x-auto p-4 text-sm font-mono min-h-[3.5rem]"
        >
            <Code code={code} lang={lang as any} theme="vitesse-dark" wrap />
        </div>

        <button
            id={`copy-btn-${id}`}
            class="absolute right-2 top-2 h-8 w-8 rounded-md flex items-center justify-center text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800 opacity-0 group-hover:opacity-100 transition-opacity focus:opacity-100"
            aria-label="Copy code"
            data-code={code}
        >
            <Copy className="h-4 w-4 copy-icon" />
            <Check className="h-4 w-4 check-icon hidden" />
        </button>
    </div>
</div>

<script define:vars={{ id }}>
    const btn = document.getElementById(`copy-btn-${id}`);

    if (btn) {
        btn.addEventListener("click", async () => {
            const code = btn.dataset.code;
            const copyIcon = btn.querySelector(".copy-icon");
            const checkIcon = btn.querySelector(".check-icon");

            try {
                await navigator.clipboard.writeText(code);

                // Toggle icons
                copyIcon.classList.add("hidden");
                checkIcon.classList.remove("hidden");

                setTimeout(() => {
                    copyIcon.classList.remove("hidden");
                    checkIcon.classList.add("hidden");
                }, 2000);
            } catch (err) {
                console.error("Failed to copy:", err);
            }
        });
    }
</script>
