---
const onlineGames = [
    { name: "Bandit", link: "/wargames/bandit" },
    { name: "Natas", link: "/wargames/natas" },
    { name: "Leviathan", link: "/wargames/leviathan" },
    { name: "Krypton", link: "/wargames/krypton" },
    { name: "Narnia", link: "/wargames/narnia" },
    { name: "Behemoth", link: "/wargames/behemoth" },
    { name: "Utumno", link: "/wargames/utumno" },
    { name: "Maze", link: "/wargames/maze" },
    { name: "Vortex", link: "/wargames/vortex" },
    { name: "Manpage", link: "/wargames/manpage" },
    { name: "Drifter", link: "/wargames/drifter" },
    { name: "FormulaOne", link: "/wargames/formulaone" },
];

const offlineGames = [{ name: "Semtex", link: "/wargames/semtex" }];

const releasedGames = [
    { name: "HES2010", link: "/wargames/hes2010" },
    { name: "Abraxas", link: "/wargames/abraxas" },
    { name: "Monxla", link: "/wargames/monxla" },
    { name: "Kishi", link: "/wargames/kishi" },
];

const { pathname } = Astro.url;

const categories = [
    {
        title: "Online",
        icon: "●",
        color: "text-emerald-400",
        games: onlineGames,
    },
    {
        title: "Offline",
        icon: "○",
        color: "text-amber-400",
        games: offlineGames,
    },
    {
        title: "Released",
        icon: "◆",
        color: "text-cyan-400",
        games: releasedGames,
    },
];
---

<aside class="w-full shrink-0 md:w-56 lg:w-64">
    {
        categories.map((cat, idx) => (
            <nav class={idx > 0 ? "mt-4" : ""}>
                <div class="mb-2 flex items-center gap-2 px-3">
                    <span class={`text-xs ${cat.color}`}>{cat.icon}</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500">
                        {cat.title}
                    </span>
                </div>
                <div class="rounded-lg border border-white/10 bg-white/5 p-2 space-y-0.5">
                    {cat.games.map((game) => {
                        const isActive = pathname.startsWith(game.link);
                        return (
                            <a
                                href={game.link}
                                class={`block rounded-md px-3 py-1.5 text-sm no-underline transition-colors ${
                                    isActive
                                        ? "bg-white/10 text-white"
                                        : "text-neutral-400 hover:bg-white/5 hover:text-white"
                                }`}
                            >
                                {game.name}
                            </a>
                        );
                    })}
                </div>
            </nav>
        ))
    }
</aside>
