---
import { formatPath } from "@/lib/utils";

const onlineGames = [
    { name: "Bandit", link: formatPath("/wargames/bandit") },
    { name: "Natas", link: formatPath("/wargames/natas") },
    { name: "Leviathan", link: formatPath("/wargames/leviathan") },
    { name: "Krypton", link: formatPath("/wargames/krypton") },
    { name: "Narnia", link: formatPath("/wargames/narnia") },
    { name: "Behemoth", link: formatPath("/wargames/behemoth") },
    { name: "Utumno", link: formatPath("/wargames/utumno") },
    { name: "Maze", link: formatPath("/wargames/maze") },
    { name: "Vortex", link: formatPath("/wargames/vortex") },
    { name: "Manpage", link: formatPath("/wargames/manpage") },
    { name: "Drifter", link: formatPath("/wargames/drifter") },
    { name: "FormulaOne", link: formatPath("/wargames/formulaone") },
];

const offlineGames = [{ name: "Semtex", link: formatPath("/wargames/semtex") }];

const releasedGames = [
    { name: "HES2010", link: formatPath("/wargames/hes2010") },
    { name: "Abraxas", link: formatPath("/wargames/abraxas") },
    { name: "Monxla", link: formatPath("/wargames/monxla") },
    { name: "Kishi", link: formatPath("/wargames/kishi") },
];

const { pathname } = Astro.url;

const categories = [
    {
        title: "Online",
        icon: "●",
        color: "text-emerald-400",
        games: onlineGames,
    },
    {
        title: "Offline",
        icon: "○",
        color: "text-amber-400",
        games: offlineGames,
    },
    {
        title: "Released",
        icon: "◆",
        color: "text-cyan-400",
        games: releasedGames,
    },
];
---

<aside class="w-full shrink-0 md:w-56 lg:w-64">
    {
        categories.map((cat, idx) => (
            <nav class={idx > 0 ? "mt-4" : ""}>
                <div class="mb-2 flex items-center gap-2 px-3">
                    <span class={`text-xs ${cat.color}`}>{cat.icon}</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">
                        {cat.title}
                    </span>
                </div>
                <div class="rounded-lg border border-white/10 bg-white/5 p-2 space-y-0.5">
                    {cat.games.map((game) => {
                        const isActive = pathname.startsWith(game.link);
                        return (
                            <a
                                href={game.link}
                                class={`block rounded-md px-3 py-1.5 text-sm no-underline transition-colors ${
                                    isActive
                                        ? "bg-white/10 text-white"
                                        : "text-neutral-400 hover:bg-white/5 hover:text-white"
                                }`}
                            >
                                {game.name}
                            </a>
                        );
                    })}
                </div>
            </nav>
        ))
    }
</aside>
