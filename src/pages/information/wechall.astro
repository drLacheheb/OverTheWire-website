---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetDir = path.join(process.cwd(), "src", "snippets", "information");

const bashrcSnippet = fs
    .readFileSync(path.join(snippetDir, "wechall_bashrc.txt"), "utf-8")
    .trim();

const fishSnippet = fs
    .readFileSync(path.join(snippetDir, "wechall_fish.txt"), "utf-8")
    .trim();

const sshConfigSnippet = fs
    .readFileSync(path.join(snippetDir, "wechall_ssh_config.txt"), "utf-8")
    .trim();
---

<BaseLayout title="WeChall Scoreboard">
    <div class="prose max-w-none">
        <h1 class="text-3xl font-bold mb-6">WeChall Scoreboard</h1>

        <p class="mb-4">
            OverTheWire makes use of a scoreboard provided by <a
                href="https://www.wechall.net"
                class="text-blue-600 hover:text-blue-800 underline">WeChall</a
            > to allow players to track their own progress and promote some healthy
            competition between players. To make use of this scoreboard for OverTheWire
            games, you need to follow these steps:
        </p>

        <ol class="list-decimal list-inside space-y-4 mb-6">
            <li>
                First, go to <a
                    href="https://www.wechall.net"
                    class="text-blue-600 hover:text-blue-800 underline"
                    >WeChall</a
                > and register for an account.
            </li>
            <li>
                Next, log in and retrieve your WeChall token and username. Your
                WeChall username is what you registered with, while your WeChall
                token can be found on the WeChall website under <a
                    href="https://www.wechall.net/warboxes"
                    class="text-blue-600 hover:text-blue-800 underline"
                    >"Account" -&gt; "WarBoxes"</a
                >. The token looks something like
                "EDD76-1FC9F-7388B-DC6EB-E3F71-FC4CB".
            </li>
            <li>
                Next, assuming you are using the correct operating system, edit
                your
                <code>~/.bashrc</code> file and add:
                <CodeBlock code={bashrcSnippet} />

                <p class="mt-2">For <code>fish</code> users, you may run:</p>
                <CodeBlock code={fishSnippet} />

                <p class="mt-2">
                    You may need to logout and login again for these changes to
                    take effect. To test whether the environment variables are
                    registered, type "echo $WECHALLUSER", which should show that
                    environment variable.
                </p>
            </li>
            <li>
                Next, edit <code>~/.ssh/config</code> (or create it if it doesn't
                exist) and add:
                <CodeBlock code={sshConfigSnippet} />
                <p class="mt-2">
                    This configures your SSH client to transmit both username
                    and token to your remote session, so it can be used there.
                </p>
            </li>
            <li>
                Finally, you are able to easily register which levels you have
                beaten on OverTheWire by logging in through SSH the normal way,
                and invoking the "wechall" command. This command will use your
                WeChall username and WeChall token to register the level you
                have beaten with WeChall.
            </li>
        </ol>
    </div>
</BaseLayout>
