---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Edit Website">
    <div class="prose max-w-none">
        <h1 class="text-3xl font-bold mb-6">Editing this website</h1>

        <p class="mb-4">
            If you spot an error on this webpage, you may correct it yourself by
            cloning this website from <a
                href="https://github.com/OverTheWireOrg/OverTheWire-website"
                class="text-blue-600 hover:text-blue-800 underline"
                >https://github.com/OverTheWireOrg/OverTheWire-website</a
            >
            and submitting a pull request.
        </p>

        <p class="mb-4 font-bold">Thank you very much for your help!!</p>
    </div>
</BaseLayout>
