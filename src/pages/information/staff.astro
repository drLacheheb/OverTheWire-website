---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Staff">
    <div class="prose max-w-none">
        <h1 class="text-3xl font-bold mb-6">Staff</h1>

        <p class="mb-4">
            The OverTheWire staff consists of volunteers that spend their spare
            time and money maintaining the infrastructure and creating new
            games.
        </p>

        <ul class="list-disc list-inside mb-6">
            <li>Kylir</li>
            <li>semchapeu</li>
            <li>Steven "Steven" Van Acker</li>
            <li>Wrennnnnnn</li>
            <li>ypsehlig</li>
        </ul>

        <p class="mb-4">
            If you need to, you may <a
                href="/information/chat"
                class="text-blue-600 hover:text-blue-800 underline"
                >contact us through chat</a
            >.
        </p>
    </div>
</BaseLayout>
