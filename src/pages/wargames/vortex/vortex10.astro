---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 10" gameName="vortex" level={10}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Random?</h2>

    <p class="leading-relaxed mb-4">
        Read in 20 integers and write the seed used to generate those numbers in
        unsigned little endian format. You have a time limit of 30 seconds to do
        this. You must login to
        <a
            href="ssh://vortex.labs.overthewire.org:2228"
            class="text-neutral-500 hover:text-neutral-300 no-underline"
            >vortex.labs.overthewire.org</a
        >
    </p>
</GameLayout>
