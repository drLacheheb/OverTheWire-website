---
import GameLayout from "../../../layouts/GameLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippet1Path = path.join(
        process.cwd(),
        "src",
        "snippets",
        "vortex",
        "vortex5_output.txt",
);
const snippet1 = fs.readFileSync(snippet1Path, "utf-8").trim();

const snippet2Path = path.join(
        process.cwd(),
        "src",
        "snippets",
        "vortex",
        "vortex5.c",
);
const snippet2 = fs.readFileSync(snippet2Path, "utf-8").trim();
---

<GameLayout title="OverTheWire: Vortex Level 5" gameName="vortex" level={5}>
        <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
                MD5 Brute Force
        </h2>

        <p class="leading-[24px] mb-4">
                A password is required for the next level. vortex5.c and md5.h.
                a-z,A-Z,0-9 is the search space. The password length is 5 chars
                long, it was originally 7 chars long.
        </p>

        <CodeBlock code={snippet1} />

        <h3 class="text-[14pt] font-bold mt-4 mb-2">Source code</h3>

        <CodeBlock className="language-c" code={snippet2} />
</GameLayout>
