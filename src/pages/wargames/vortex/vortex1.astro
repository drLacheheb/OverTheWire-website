---
import GameLayout from "../../../layouts/GameLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetPath = path.join(
	process.cwd(),
	"src",
	"snippets",
	"vortex",
	"vortex1.c",
);
const snippet = fs.readFileSync(snippetPath, "utf-8").trim();
---

<GameLayout title="OverTheWire: Vortex Level 1" gameName="vortex" level={1}>
	<h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Canary Values</h2>

	<p class="leading-relaxed mb-4">
		We are looking for a specific value in ptr. You may need to consider how
		bash handles EOF..
	</p>

	<h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
		Reading Material
	</h2>

	<ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
		<li>
			<a
				href="http://www.phrack.com/issues/49/14.html#article"
				class="text-neutral-500 hover:text-neutral-300 no-underline"
				>Smashing the Stack for Fun and Profit</a
			>
		</li>
		<li>
			<a
				href="https://www.exploit-db.com/papers/13162/"
				class="text-neutral-500 hover:text-neutral-300 no-underline"
				>Smashing The Modern Stack For Fun And Profit</a
			>
		</li>
	</ul>

	<h3 class="text-xl font-bold mt-4 mb-2">Source code</h3>

	<CodeBlock className="language-c" code={snippet} />
</GameLayout>
