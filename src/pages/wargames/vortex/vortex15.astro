---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 15" gameName="vortex" level={15}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Weak Encryption
    </h2>

    <p class="leading-relaxed mb-4">
        You have found an encrypted file, decrypt it (some reversing, crypt and
        general analysis needed, and if you're lazy, the password is 8-bytes
        long and contains values between A and Z). You must login to
        <a
            href="ssh://vortex.labs.overthewire.org:2228"
            class="text-neutral-500 hover:text-neutral-300 no-underline"
            >vortex.labs.overthewire.org</a
        > to complete this level.
    </p>
</GameLayout>
