---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 6" gameName="vortex" level={6}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Generic Binary Exploitation
    </h2>

    <p class="leading-relaxed mb-4">
        You must disassemble this level's exploitable application in order to
        find the hole.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
        <li>
            <a
                href="http://www.exploit-db.com/papers/13216/"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Reconstructing Binaries to C For Beginners</a>
        </li>
        <li>
            <a
                href="http://www.exploit-db.com/papers/13215/"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Reverse Engineering - Functions... functions! functions!?
                sheesh</a>
        </li>
    </ul>
</GameLayout>
