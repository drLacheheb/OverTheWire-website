---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 25" gameName="vortex" level={25}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Crackploit</h2>

    <div class="p-4 mb-4 bg-[#E0E0E0] border-l-4 border-[#A0A0A0] text-black">
        <p class="font-bold">Vortex 25 &rarr; 26 is missing</p>
        <p>
            This level seems to have been lost, but we leave its description
            here for historical reasons.
        </p>
    </div>

    <p class="leading-relaxed mb-4">
        There are two challenges for this level. One is to work out the password
        for the binary (a dictionary search should get it), and then work how
        you can exploit the level. A world readable binary is in /levels/decode.
        You must login to <a
            href="ssh://vortex.labs.overthewire.org:2228"
            class="text-neutral-500 hover:text-neutral-300 no-underline"
            >vortex.labs.overthewire.org</a
        >
        to complete this level.
    </p>
</GameLayout>
