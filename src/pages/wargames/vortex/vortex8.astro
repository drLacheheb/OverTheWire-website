---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 8" gameName="vortex" level={8}>
    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Some simple reverse engineering
    </h2>

    <p class="leading-[24px] mb-4">
        Disassemble this dynamically linked executable.
    </p>

    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-[24px] mb-4">
        <li>
            <a
                href="https://web.archive.org/web/20160315083251/http://althing.cs.dartmouth.edu/local/www.acm.uiuc.edu/sigmil/RevEng/"
                class="text-[#999] hover:text-[#CCC] no-underline"
                >Reverse Engineering</a>
        </li>
    </ul>
</GameLayout>
