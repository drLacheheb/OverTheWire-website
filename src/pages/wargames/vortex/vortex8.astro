---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 8" gameName="vortex" level={8}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Some simple reverse engineering
    </h2>

    <p class="leading-relaxed mb-4">
        Disassemble this dynamically linked executable.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
        <li>
            <a
                href="https://web.archive.org/web/20160315083251/http://althing.cs.dartmouth.edu/local/www.acm.uiuc.edu/sigmil/RevEng/"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Reverse Engineering</a>
        </li>
    </ul>
</GameLayout>
