---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Vortex Level 16" gameName="vortex" level={16}>
    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">The BOFH</h2>

    <p class="leading-[24px] mb-4">
        This level requires finding 100 bits out of a 128 bit randomly generated
        hashed key. You must login to
        <a
            href="ssh://vortex.labs.overthewire.org:2228"
            class="text-[#999] hover:text-[#CCC] no-underline"
            >vortex.labs.overthewire.org</a
        > to complete this level.
    </p>
</GameLayout>
