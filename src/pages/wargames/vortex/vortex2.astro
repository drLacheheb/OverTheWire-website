---
import GameLayout from "../../../layouts/GameLayout.astro";
import { CodeBlock } from "@/components/ui/code-block";
import fs from "node:fs";
import path from "node:path";

const snippetPath = path.join(process.cwd(), "src", "snippets", "vortex", "vortex2.c");
const snippet = fs.readFileSync(snippetPath, "utf-8").trim();
---

<GameLayout title="OverTheWire: Vortex Level 2" gameName="vortex" level={2}>
  <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">Level Goal</h2>

  <p class="leading-[24px] mb-4">Create a special tar file</p>

  <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
    Helpful Reading Material
  </h2>

  <ul class="list-disc list-inside pl-4 leading-[24px] mb-4">
    <li>
      <a
        href="http://linux.die.net/man/1/tar"
        class="text-[#999] hover:text-[#CCC] no-underline">GNU tar manual</a
      >
    </li>
  </ul>

  <h3 class="text-[14pt] font-bold mt-4 mb-2">Source code</h3>

  <CodeBlock client:visible className="language-c" code={snippet} />
</GameLayout>
