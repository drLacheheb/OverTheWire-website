---
import GameLayout from "../../../layouts/GameLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetPath = path.join(
        process.cwd(),
        "src",
        "snippets",
        "vortex",
        "vortex24.c",
);
const snippet = fs.readFileSync(snippetPath, "utf-8").trim();
---

<GameLayout title="OverTheWire: Vortex Level 24" gameName="vortex" level={24}>
        <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
                Guess the seed
        </h2>

        <p class="leading-relaxed mb-4">
                You might want to analyze "random_r.c" from the GLIBC source
                code.
        </p>

        <h3 class="text-xl font-bold mt-4 mb-2">Source code</h3>

        <CodeBlock className="language-c" code={snippet} />
</GameLayout>
