<GameLayout title="OverTheWire: Vortex Level 11" gameName="vortex" level={11}>
    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Chunk Corruption
    </h2>

    <p class="leading-[24px] mb-4">
        You must corrupt the heap in order to gain arbitrary control of this
        program. Do recall, the application is using phkmalloc.
    </p>

    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
