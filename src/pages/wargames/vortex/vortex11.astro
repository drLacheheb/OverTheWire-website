---
import GameLayout from "../../../layouts/GameLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippet1Path = path.join(
    process.cwd(),
    "src",
    "snippets",
    "vortex",
    "vortex11.c",
);
const snippet1 = fs.readFileSync(snippet1Path, "utf-8").trim();

const snippet2Path = path.join(
    process.cwd(),
    "src",
    "snippets",
    "vortex",
    "phkmalloc.c",
);
const snippet2 = fs.readFileSync(snippet2Path, "utf-8").trim();
---

<GameLayout title="OverTheWire: Vortex Level 11" gameName="vortex" level={11}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Chunk Corruption
    </h2>

    <p class="leading-relaxed mb-4">
        You must corrupt the heap in order to gain arbitrary control of this
        program. Do recall, the application is using phkmalloc.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
        <li>
            <a
                href="http://www.ouah.org/BSD-heap-smashing.txt"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >BSD Heap Smashing</a
            >
        </li>
        <li>
            <a
                href="http://www.phrack.org/issues.html?issue=57&id=9#article"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Once upon a free()</a
            >
        </li>
        <li>
            <a
                href="http://www.phrack.org/issues.html?issue=61&id=6#article"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Advanced Doug Lea's malloc exploits</a
            >
        </li>
        <li>
            <a
                href="http://archive.cert.uni-stuttgart.de/vuln-dev/2004/02/msg00025.html"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >Exploiting the Wilderness</a
            >
        </li>
    </ul>

    <h3 class="text-xl font-bold mt-4 mb-2">Source code</h3>

    <CodeBlock className="language-c" code={snippet1} />

    <h3 class="text-xl font-bold mt-4 mb-2">phkmalloc.c</h3>

    <CodeBlock className="language-c" code={snippet2} />
</GameLayout>
