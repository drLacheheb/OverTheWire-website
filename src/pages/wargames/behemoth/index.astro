---
import GameLayout from "../../../layouts/GameLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetDir = path.join(process.cwd(), "src", "snippets", "behemoth");

const infoSnippet = fs
    .readFileSync(path.join(snippetDir, "info.txt"), "utf-8")
    .trim();

const credsSnippet = fs
    .readFileSync(path.join(snippetDir, "creds.txt"), "utf-8")
    .trim();
---

<GameLayout title="OverTheWire: Behemoth" gameName="behemoth">
    <h2
        class="text-3xl font-normal text-neutral-500 mt-6 mb-4 border-b border-neutral-700 pb-2"
    >
        Behemoth
    </h2>

    <h3 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Don't let behemoth get the better of you.
    </h3>

    <p class="leading-relaxed mb-4">
        Behemoth is a wargame that has been rescued from the demise of
        <strong>intruded.net</strong>, previously hosted on
        behemoth.intruded.net. <strong>Big thanks to adc, morla and reth</strong
        > for their help in resurrecting this game!
    </p>

    <p class="leading-relaxed mb-4">
        What follows below is the original description of behemoth, copied from
        intruded.net:
    </p>

    <CodeBlock code={infoSnippet} />

    <p class="leading-relaxed mb-4">
        Behemoth's levels are called <strong
            >behemoth0, behemoth1, ... etc.</strong
        > and can be accessed on <strong>behemoth.labs.overthewire.org</strong> through
        SSH on port 2221.
    </p>

    <p class="leading-relaxed mb-4">To login to the first level use:</p>

    <CodeBlock code={credsSnippet} />

    <p class="leading-relaxed mb-4">
        Data for the levels can be found in <strong>/behemoth/</strong>.
    </p>
</GameLayout>
