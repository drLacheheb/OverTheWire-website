---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetDir = path.join(process.cwd(), "src", "snippets", "hes2010");

const instructionsSnippet = fs
    .readFileSync(path.join(snippetDir, "instructions.txt"), "utf-8")
    .trim();
---

<BaseLayout title="OverTheWire: HES2010">
    <h2
        class="text-[24pt] font-normal text-[#999] mt-6 mb-4 border-b border-[#CCC] pb-2"
    >
        [RELEASED] HES2010
    </h2>

    <p class="leading-[24px] mb-4">
        This wargame was introduced at the <a
            href="http://hackitoergosum.org/"
            class="text-[#999] hover:text-[#CCC] no-underline"
            >Hackito Ergo Sum (HES)</a
        > 2010 conference in Paris and is centered around the <strong
            >fictitious company dirty-underwear.com</strong
        >
    </p>

    <p class="leading-[24px] mb-4">
        The winners of this wargame at HES2010 were <strong
            >CCCP and morla</strong
        >.
    </p>

    <p class="leading-[24px] mb-4">
        As of January 2012, the HES2010 game has been released to the public and
        can be downloaded <a
            href="http://images.overthewire.org/HES2010 - OverTheWire Wargame.ova"
            class="text-[#999] hover:text-[#CCC] no-underline">here</a
        >.
    </p>

    <p class="leading-[24px] mb-4">
        The wargame has its own local website on the virtual machine. Once the
        VM is running, you can find it at <a
            href="http://192.168.66.66"
            class="text-[#999] hover:text-[#CCC] no-underline"
            >http://192.168.66.66</a
        >
    </p>

    <p class="leading-[24px] mb-4">
        The following instructions are also included on the diskimage:
    </p>

    <h3 class="text-[14pt] font-bold mt-4 mb-2">instructions.txt</h3>

    <CodeBlock code={instructionsSnippet} />
</BaseLayout>
