---
import GameLayout from "../../../layouts/GameLayout.astro";
import { ConnectionInfo } from "@/components/ConnectionInfo";
---

<GameLayout title="OverTheWire: Krypton Level 0" gameName="krypton" level={0}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Level Info</h2>

    <p class="leading-relaxed mb-4">
        Welcome to Krypton! The first level is easy. The following string
        encodes the password using Base64:
    </p>

    <ConnectionInfo
        client:load
        username="krypton1"
        password="KRYPTONISGREAT"
        url="ssh krypton1@krypton.labs.overthewire.org -p 2231"
    />

    <p class="leading-relaxed mb-4">
        Use this password to log in to krypton.labs.overthewire.org with
        username krypton1 using SSH on port 2231. You can find the files for
        other levels in /krypton/
    </p>
</GameLayout>
