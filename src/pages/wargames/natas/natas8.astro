---
import GameLayout from "../../../layouts/GameLayout.astro";
import { CodeBlock } from "@/components/ui/code-block";
---

<GameLayout title="OverTheWire: Natas Level 8" gameName="natas" level={8}>
    <h2 class="text-xl font-bold text-white mb-4">Level 8</h2>

    <p class="text-neutral-300 mb-4">
        Input secret:
        <form action="" method="post" class="inline-block ml-2">
            <input
                type="text"
                name="secret"
                class="bg-neutral-800 border border-neutral-700 rounded px-2 py-1 text-white text-sm"
            />
            <input
                type="submit"
                name="submit"
                value="Submit"
                class="ml-2 bg-neutral-700 hover:bg-neutral-600 text-white rounded px-3 py-1 text-sm cursor-pointer transition-colors"
            />
        </form>
    </p>

    <div class="mb-4 text-neutral-300">
        <a
            href="index-source.html"
            class="text-neutral-400 hover:text-white underline transition-colors"
            >View sourcecode</a
        >
    </div>

    <CodeBlock client:visible>&lt;!-- hint: wrong secret --&gt;</CodeBlock>
</GameLayout>
