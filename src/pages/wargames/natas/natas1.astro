---
import GameLayout from "../../../layouts/GameLayout.astro";
import { CodeBlock } from "@/components/ui/code-block";
---

<GameLayout title="OverTheWire: Natas Level 1" gameName="natas" level={1}>
    <h2 class="text-xl font-bold text-white mb-4">Level 1</h2>

    <p class="text-neutral-300 mb-4">
        You can find the password for the next level on this page, but right
        clicking has been blocked!
    </p>

    <CodeBlock client:visible
        >GTK, GIMP, and a whole lot more HTML, CSS, PHP, MySQL, and a whole lot
        more Linux, Apache, MySQL, PHP, and a whole lot more
    </CodeBlock>
</GameLayout>
