---
import GameLayout from "../../../layouts/GameLayout.astro";
import { CodeBlock } from "@/components/ui/code-block";
---

<GameLayout title="OverTheWire: Natas Level 13" gameName="natas" level={13}>
    <h2 class="text-xl font-bold text-white mb-4">Level 13</h2>

    <p class="text-neutral-300 mb-4">
        For security reasons, we now only accept image files!<br />
        Upload a JPEG file (max 1KB):
        <form
            enctype="multipart/form-data"
            action=""
            method="post"
            class="inline-block ml-2"
        >
            <input type="hidden" name="MAX_FILE_SIZE" value="1000" />
            <input
                type="hidden"
                name="filename"
                value="<? print genRandomString(); ?>.jpg"
            />
            <input
                type="file"
                name="uploadedfile"
                class="text-neutral-300 text-sm"
            />
            <input
                type="submit"
                value="Upload File"
                class="ml-2 bg-neutral-700 hover:bg-neutral-600 text-white rounded px-3 py-1 text-sm cursor-pointer transition-colors"
            />
        </form>
    </p>

    <div class="mb-4 text-neutral-300">
        <a
            href="index-source.html"
            class="text-neutral-400 hover:text-white underline transition-colors"
            >View sourcecode</a
        >
    </div>

    <CodeBlock client:visible
        >&lt;!-- hint: check file signature --&gt;</CodeBlock
    >
</GameLayout>
