---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetDir = path.join(process.cwd(), "src", "snippets", "abraxas");

const instructionsSnippet = fs
    .readFileSync(path.join(snippetDir, "instructions.txt"), "utf-8")
    .trim();
---

<BaseLayout title="OverTheWire: Abraxas">
    <h2
        class="text-[24pt] font-normal text-[#999] mt-6 mb-4 border-b border-[#CCC] pb-2"
    >
        [RELEASED] Abraxas (HES2011)
    </h2>

    <p class="leading-6 mb-4">
        This wargame was introduced at the <a
            href="http://hackitoergosum.org/"
            class="text-[#999] hover:text-[#CCC] no-underline"
            >Hackito Ergo Sum (HES)</a
        > 2011 conference in Paris and is centered around the <strong
            >fictitious company dildosfromspace.com</strong
        >
    </p>

    <p class="leading-6 mb-4">
        The wargame has its own website with the entire backstory. You can find
        it <a
            href="http://agent7a69.blogspot.com"
            class="text-[#999] hover:text-[#CCC] no-underline">here</a
        >.
    </p>

    <p class="leading-6 mb-4">
        As of September 2011, the Abraxas game has been released to the public
        and can be downloaded <a
            href="http://images.overthewire.org/Abraxas%20-%20OverTheWire%20Wargame.ova"
            class="text-[#999] hover:text-[#CCC] no-underline">here</a
        >.
    </p>

    <p class="leading-6 mb-4">
        The following instructions are also included on the diskimage:
    </p>

    <h3 class="text-[14pt] font-bold mt-4 mb-2">instructions.txt</h3>

    <CodeBlock code={instructionsSnippet} />
</BaseLayout>
