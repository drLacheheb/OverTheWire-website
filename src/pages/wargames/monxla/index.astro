---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import fs from "node:fs";
import path from "node:path";

const snippetDir = path.join(process.cwd(), "src", "snippets", "monxla");

const instructionSnippet = fs
    .readFileSync(path.join(snippetDir, "instructions.txt"), "utf-8")
    .trim();
---

<BaseLayout title="OverTheWire: Monxla">
    <h2
        class="text-[24pt] font-normal text-[#999] mt-6 mb-4 border-b border-[#CCC] pb-2"
    >
        [RELEASED] Monxla (HES2012)
    </h2>

    <p class="leading-[24px] mb-4">
        This wargame was introduced at the <a
            href="http://hackitoergosum.org/"
            class="text-[#999] hover:text-[#CCC] no-underline"
            >Hackito Ergo Sum (HES)</a
        > 2012 conference in Paris and is centered around the <strong
            >fictitious Russian crime family Nasenko</strong
        >.
    </p>

    <p class="leading-[24px] mb-4">
        As of November 2012, the Monxla game has been released to the public and
        can be downloaded <a
            href="http://images.overthewire.org/Monxla%20-%20OverTheWire%20Wargame.iso"
            class="text-[#999] hover:text-[#CCC] no-underline">here</a
        >.
    </p>

    <p class="leading-[24px] mb-4">
        The following instructions are also included on the livecd:
    </p>

    <h3 class="text-[14pt] font-bold mt-4 mb-2">instructions.txt</h3>

    <CodeBlock code={instructionSnippet} />
</BaseLayout>
