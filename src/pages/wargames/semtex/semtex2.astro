---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Semtex Level 2" gameName="semtex" level={2}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Dynamic tricks
    </h2>

    <p class="leading-relaxed mb-4">This program checks your user ID.</p>

    <p class="leading-relaxed mb-4">
        Perhaps you can trick it, so that it thinks you have a different one.
    </p>

    <p class="leading-relaxed mb-4">Think dynamically.</p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
        <li>
            <a
                href="http://www.google.com/search?q=linux+function+interception"
                class="text-neutral-500 hover:text-neutral-300 no-underline">Link</a>
        </li>
    </ul>
</GameLayout>
