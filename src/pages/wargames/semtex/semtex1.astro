---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Semtex Level 1" gameName="semtex" level={1}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Simple encryption
    </h2>

    <p class="leading-relaxed mb-4">
        A password has been crypted using the /semtex/semtex1 tool. The crypted
        password is HRXDZNWEAWWCP. You have to reverse engineer the algorithm
        and decrypt the password. You might try the -v switch for encrypt.
    </p>
</GameLayout>
