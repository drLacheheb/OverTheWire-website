---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 18" gameName="bandit" level={18}>
    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">Level Goal</h2>

    <p class="leading-[24px] mb-4">
        There are 2 files in the homedirectory: <strong
            >passwords.old and passwords.new</strong
        >. The password for the next level is in <strong>passwords.new</strong> and
        is the only line that has been changed between <strong
            >passwords.old and passwords.new</strong
        >
    </p>

    <p class="leading-[24px] mb-4 font-bold">
        NOTE: if you have solved this level and see 'Byebye!' when trying to log
        into bandit18, this is related to the next level, bandit19
    </p>

    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Commands you may need to solve this level
    </h2>

    <p class="leading-[24px] mb-4">cat, grep, ls, diff</p>
</GameLayout>
