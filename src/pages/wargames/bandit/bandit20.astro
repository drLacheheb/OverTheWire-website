---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 20" gameName="bandit" level={20}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Level Goal</h2>

    <p class="leading-relaxed mb-4">
        To gain access to the next level, you should use the setuid binary in
        the homedirectory. Execute it without arguments to find out how to use
        it. The password for this level can be found in the usual place
        (/etc/bandit_pass), after you have used the setuid binary.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Helpful Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-relaxed mb-4">
        <li>
            <a
                href="https://en.wikipedia.org/wiki/Setuid"
                class="text-neutral-500 hover:text-neutral-300 no-underline"
                >setuid on Wikipedia</a>
        </li>
    </ul>
</GameLayout>
