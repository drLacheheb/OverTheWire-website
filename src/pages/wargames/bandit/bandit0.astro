---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 0" gameName="bandit" level={0}>
    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">Level Goal</h2>

    <p class="leading-[24px] mb-4">
        The goal of this level is for you to log into the game using SSH. The
        host to which you need to connect is
        <strong>bandit.labs.overthewire.org</strong>, on port 2220. The username
        is <strong>bandit0</strong> and the password is <strong>bandit0</strong
        >. Once logged in, go to the <a
            href="/wargames/bandit/bandit1"
            class="text-[#999] hover:text-[#CCC] no-underline">Level 1</a
        > page to find out how to beat Level 1.
    </p>

    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Commands you may need to solve this level
    </h2>

    <p class="leading-[24px] mb-4">
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/ssh.1.html"
            class="text-[#999] hover:text-[#CCC] no-underline">ssh</a
        >
    </p>

    <h2 class="text-[18pt] font-normal text-[#999] mt-6 mb-2">
        Helpful Reading Material
    </h2>

    <ul class="list-disc list-inside pl-4 leading-[24px] mb-4">
        <li>
            <a
                href="https://en.wikipedia.org/wiki/Secure_Shell"
                class="text-[#999] hover:text-[#CCC] no-underline"
                >Secure Shell (SSH) on Wikipedia</a>
        </li>
        <li>
            <a
                href="https://itsfoss.com/ssh-to-port/"
                class="text-[#999] hover:text-[#CCC] no-underline"
                >How to use SSH with a non-standard port on It's FOSS</a>
        </li>
        <li>
            <a
                href="https://www.wikihow.com/Use-SSH"
                class="text-[#999] hover:text-[#CCC] no-underline"
                >How to use SSH with ssh-keys on wikiHow</a>
        </li>
    </ul>
</GameLayout>
