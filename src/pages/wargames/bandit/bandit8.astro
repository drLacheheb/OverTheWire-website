---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 8" gameName="bandit" level={8}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Level Goal</h2>

    <p class="leading-relaxed mb-4">
        The password for the next level is stored in the file <strong
            >data.txt</strong
        >
        next to the word <strong>millionth</strong>
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Commands you may need to solve this level
    </h2>

    <p class="leading-relaxed mb-4">
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/man.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">man</a
        >, grep, sort, uniq, strings, base64, tr, tar, gzip, bzip2, xxd
    </p>
</GameLayout>
