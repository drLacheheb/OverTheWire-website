---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 19" gameName="bandit" level={19}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Level Goal</h2>

    <p class="leading-relaxed mb-4">
        The password for the next level is stored in a file <strong
            >readme</strong
        > in the homedirectory. Unfortunately, someone has modified <strong
            >.bashrc</strong
        >
        to log you out when you log in with SSH.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Commands you may need to solve this level
    </h2>

    <p class="leading-relaxed mb-4">ssh, ls, cat</p>
</GameLayout>
