---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="OverTheWire: Bandit Level 5" gameName="bandit" level={5}>
    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">Level Goal</h2>

    <p class="leading-relaxed mb-4">
        The password for the next level is stored in the only human-readable
        file in the <strong>inhere</strong> directory. Tip: if your terminal is messed
        up, try the "reset" command.
    </p>

    <h2 class="text-2xl font-normal text-neutral-500 mt-6 mb-2">
        Commands you may need to solve this level
    </h2>

    <p class="leading-relaxed mb-4">
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/ls.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">ls</a
        >,
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/cd.1posix.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">cd</a
        >,
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/cat.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">cat</a
        >,
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/file.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">file</a
        >,
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/du.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">du</a
        >,
        <a
            href="https://manpages.ubuntu.com/manpages/noble/man1/find.1.html"
            class="text-neutral-500 hover:text-neutral-300 no-underline">find</a
        >
    </p>
</GameLayout>
