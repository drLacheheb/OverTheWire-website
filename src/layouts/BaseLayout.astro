---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
    title?: string;
}

const { title = "OverTheWire" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="OverTheWire" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link
            href="http://fonts.googleapis.com/css?family=Inconsolata|Pontano+Sans|Maven+Pro&subset=latin,latin-ext"
            rel="stylesheet"
            type="text/css"
        />
        <title>{title}</title>
    </head>
    <body
        class="min-h-screen bg-neutral-950 text-neutral-100 font-['Pontano_Sans','Maven_Pro','Helvetica','Arial',sans-serif] text-[12pt] m-0 p-0"
    >
        <Navbar />

        <main
            id="content"
            class="mx-auto max-w-7xl px-4 pt-24 pb-8 sm:px-6 lg:px-8"
        >
            <slot />
        </main>
    </body>
</html>
