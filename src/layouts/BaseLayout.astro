---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { formatPath } from "@/lib/utils";

interface Props {
    title?: string;
}

const { title = "OverTheWire" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link
            rel="icon"
            type="image/png"
            href={formatPath("/favicon-96x96.png")}
            sizes="96x96"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href={formatPath("/favicon.svg")}
        />
        <link rel="shortcut icon" href={formatPath("/favicon.ico")} />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={formatPath("/apple-touch-icon.png")}
        />
        <meta name="apple-mobile-web-app-title" content="OverTheWire" />
        <link rel="manifest" href={formatPath("/site.webmanifest")} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Grotesk:wght@300..700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body
        class="min-h-screen bg-neutral-950 text-neutral-100 font-['Space_Grotesk',sans-serif] text-base m-0 p-0"
    >
        <Navbar />

        <main
            id="content"
            class="mx-auto max-w-7xl px-4 pt-24 pb-8 sm:px-6 lg:px-8"
        >
            <slot />
        </main>
    </body>
</html>
