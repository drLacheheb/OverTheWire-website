---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
}

const { title = "OverTheWire" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="OverTheWire" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link
            href="http://fonts.googleapis.com/css?family=Inconsolata|Pontano+Sans|Maven+Pro&subset=latin,latin-ext"
            rel="stylesheet"
            type="text/css"
        />
        <title>{title}</title>
    </head>
    <body
        class="bg-white text-black font-['Pontano_Sans','Maven_Pro','Helvetica','Arial',sans-serif] text-[12pt] m-0 p-0 dark:bg-black dark:text-white"
    >
        <div
            id="sitename"
            class="absolute top-0 right-[36px] z-10 font-['origins','Helvetica','Arial',sans-serif] text-[40pt] leading-[64px] text-black dark:text-white"
        >
            <a href="/" class="no-underline font-normal text-inherit"
                >OverTheWire</a
            >
        </div>
        <div
            id="siteslogan"
            class="absolute top-[51px] right-[36px] z-10 text-[7.5pt] text-[#CCC]"
        >
            We're hackers, and we are good-looking. We are the 1%.
        </div>

        <Navbar />

        <main id="content" class="mt-[110px] mr-[36px] mb-[20px] ml-[236px]">
            <slot />
        </main>

        <Footer />
    </body>
</html>
