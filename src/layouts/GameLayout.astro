---
import BaseLayout from "./BaseLayout.astro";
import LevelSidebar from "../components/LevelSidebar.astro";
import gamesData from "../data/games";

interface Props {
    title: string;
    gameName: string;
    level?: number;
    children?: any;
}

const { title, gameName, level } = Astro.props;

// Level Title Logic
let levelTitle = "";
if (level !== undefined) {
    const gameData = gamesData[gameName];
    const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const displayName = capitalize(gameName);

    if (gameData) {
        if (!gameData.specialNumbering) {
            if (level === 0) {
                levelTitle = `${displayName} Level ${level}`;
            } else {
                levelTitle = `${displayName} Level ${level - 1} → Level ${level}`;
            }
        } else {
            levelTitle = `${displayName} Level ${level} → Level ${level + 1}`;
        }
    }
}
---

<BaseLayout title={title}>
    <div class="flex flex-col gap-8 md:flex-row">
        <LevelSidebar gameName={gameName} />

        <div class="min-w-0 flex-1">
            {
                levelTitle && (
                    <div class="mb-6">
                        <h1 class="text-2xl font-light text-neutral-200">
                            {levelTitle}
                        </h1>
                    </div>
                )
            }

            <slot />
        </div>
    </div>
</BaseLayout>
