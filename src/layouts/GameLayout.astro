---
import BaseLayout from "./BaseLayout.astro";
import LevelSidebar from "../components/LevelSidebar.astro";
import gamesData from "../data/games";
import { formatPath } from "@/lib/utils";

interface Props {
    title: string;
    gameName: string;
    level?: number;
    children?: any;
}

const { title, gameName, level } = Astro.props;

let levelTitle = "";
if (level !== undefined) {
    const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const displayName = capitalize(gameName);
    levelTitle = `${displayName} Level ${level}`;
}

const gameData = gamesData[gameName];
const currentLevel = level;
let prevUrl = null;
let nextUrl = null;

if (gameData && currentLevel !== undefined) {
    if (currentLevel > 0) {
        prevUrl = formatPath(
            `/wargames/${gameName}/${gameName}${currentLevel - 1}`,
        );
    } else if (currentLevel === 0) {
        prevUrl = formatPath(`/wargames/${gameName}`);
    }

    if (currentLevel < gameData.lastlevel) {
        nextUrl = formatPath(
            `/wargames/${gameName}/${gameName}${currentLevel + 1}`,
        );
    }
} else if (gameData && level === undefined) {
    // Landing page
    nextUrl = formatPath(`/wargames/${gameName}/${gameName}0`);
}
---

<BaseLayout title={title}>
    <div class="flex flex-col gap-8 md:flex-row">
        <LevelSidebar gameName={gameName} />
        <div class="min-w-0 flex-1">
            {
                levelTitle && (
                    <div class="mb-6">
                        <h1 class="text-2xl font-light text-neutral-200">
                            {levelTitle}
                        </h1>
                    </div>
                )
            }
            <slot />

            {/* Mobile Navigation Arrows */}
            {
                (prevUrl || nextUrl) && (
                    <div class="mt-8 flex justify-between border-t border-neutral-800 pt-6">
                        {prevUrl ? (
                            <a
                                href={prevUrl}
                                class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-2 text-sm text-neutral-300 transition-colors hover:bg-neutral-900 hover:text-white"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m15 18-6-6 6-6" />
                                </svg>
                                Previous
                            </a>
                        ) : (
                            <div />
                        )}

                        {nextUrl ? (
                            <a
                                href={nextUrl}
                                class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-2 text-sm text-neutral-300 transition-colors hover:bg-neutral-900 hover:text-white"
                            >
                                Next
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </a>
                        ) : (
                            <div />
                        )}
                    </div>
                )
            }
        </div>
    </div>
</BaseLayout>
